\":\"Career Opportunities\"},\"aboutMenu\":{\"mission\":\"Mission\",\"organigram\":\"Organigram\",\"sitemap\":\"Sitemap\",\"reports\":\"Reports\",\"regulations\":\"Regulations\",\"guidelines\":\"Guidelines\",\"tour\":\"Virtual Tour\",\"rooms\":\"Rooms \u0026 calendar\",\"contact\":\"Contact\"},\"search\":{\"placeholder\":\"Search...\",\"mobilePlaceholder\":\"Search the site...\",\"button\":\"Search\",\"chatbot\":\"AIRi chatbot\",\"knowledgeGraph\":\"Knowledge graphs\"}},\"home\":{\"metadata\":{\"title\":\"AIRI - Home\",\"description\":\"Advancing research, innovation, and exploration in artificial intelligence at the Technical University of Cluj-Napoca - AIRi@UTCN\"},\"Hero\":{\"title\":\"Artificial Intelligence Research Institute\",\"subtitle\":\"Advancing research, innovation, and exploration in the field of artificial intelligence at the Technical University of Cluj-Napoca.\",\"learnMore\":\"Learn More\",\"altHero\":\"AI Research Hero\",\"altQr\":\"Sign up QR code\"},\"Notice\":{\"text\":\"AIRi@UTCN is currently under construction. Follow our channels for updates.\"},\"About\":{\"title\":\"About Us\",\"description\":\"The Artificial Intelligence Research Institute (AIRi) is a nexus for collaborative research at the Technical University of Cluj-Napoca. AIRi@UTCN promotes excellence in AI theory and practice, bringing together researchers across UTCN around a vision of open collaboration. Our work spans interdisciplinary research, AI literacy across disciplines, and impact through business and public co-creation partnerships.\"},\"Cards\":{\"research\":{\"title\":\"Research\",\"description\":\"Explore our research units and projects.\"},\"people\":{\"title\":\"People\",\"description\":\"Meet our researchers and staff.\"},\"resources\":{\"title\":\"Resources\",\"description\":\"Tools, resources, and learning materials.\"}},\"LatestNews\":{\"title\":\"Latest News\",\"viewAll\":\"View All News →\",\"viewArticle\":\"View article\",\"readMore\":\"Read more\",\"emptyState\":\"News articles will appear here once published.\",\"visitNews\":\"Visit News \u0026 Events →\"},\"Social\":{\"title\":\"Follow Us on LinkedIn\",\"visit\":\"Visit LinkedIn →\"}},\"contact\":{\"PageHeader\":{\"title\":\"Contact Us\",\"subtitle\":\"We would love to hear from you! Whether you have a question about our research, events, or anything else, our team is ready to answer all your questions.\"},\"Social\":{\"title\":\"Connect With Us\"},\"Form\":{\"title\":\"Contact Form\",\"iframeTitle\":\"Contact Us Form\"},\"Location\":{\"title\":\"Our Location\",\"address\":\"📍 Strada Observatorului 2, Cluj-Napoca 400347, Romania\",\"iframeTitle\":\"Location Map\"}},\"engagement\":{\"academic\":{\"title\":\"Academic engagement\",\"description\":\"Collaborations with universities and institutes: co-tutoring, joint courses, workshops, research visits, mobility.\",\"contactButton\":\"Contact the academic team\",\"selectTopic\":\"Select a topic from the left menu.\",\"Tabs\":{\"Overview\":{\"label\":\"Overview\",\"subtabs\":{\"partnerships\":\"Academic partnerships\",\"teaching\":\"Teaching \u0026 training\",\"mobility\":\"Mobility\"}},\"Initiatives\":{\"label\":\"Initiatives\",\"subtabs\":{\"schools\":\"Summer schools \u0026 workshops\",\"seminars\":\"Joint seminars\",\"visits\":\"Research visits\"}},\"Courses\":{\"label\":\"Courses \u0026 Workshops\",\"subtabs\":{\"ml\":\"Machine Learning\",\"robotics\":\"Robotics \u0026 Vision\",\"hpc\":\"HPC for AI\",\"ethics\":\"AI Ethics \u0026 Safety\"}},\"Mobility\":{\"label\":\"Co-tutoring \u0026 Mobility\",\"subtabs\":{\"phd\":\"Co-supervision\",\"grants\":\"Mobility grants\",\"placements\":\"Placements \u0026 exchanges\"}}},\"Content\":{\"Overview\":{\"partnerships\":{\"title\":\"Academic partnerships\",\"desc\":\"A network of collaborations and joint activities.\"},\"teaching\":{\"title\":\"Teaching \u0026 training\",\"desc\":\"Courses, summer schools, and workshops.\"},\"mobility\":{\"title\":\"Mobility\",\"desc\":\"Co-tutoring, visits, internships, exchanges.\"}},\"Initiatives\":{\"schools\":{\"title\":\"Summer schools \u0026 workshops\",\"desc\":\"International and local events for students and researchers.\"},\"seminars\":{\"title\":\"Joint seminars\",\"desc\":\"Collaborative talks \u0026 invited speakers.\"},\"visits\":{\"title\":\"Research visits\",\"desc\":\"Short-term \u0026 long-term research stays.\"}},\"Courses\":{\"ml\":{\"title\":\"Machine Learning\",\"desc\":\"Joint courses, applied modules, projects.\"},\"robotics\":{\"title\":\"Robotics \u0026 Vision\",\"desc\":\"Hands-on labs, automation, and vision systems.\"},\"hpc\":{\"title\":\"HPC for AI\",\"desc\":\"GPU programming \u0026 large-scale AI training.\"},\"ethics\":{\"title\":\"AI Ethics \u0026 Safety\",\"desc\":\"Fairness, explainability \u0026 governance in AI.\"}},\"Mobility\":{\"phd\":{\"title\":\"Co-supervision\",\"desc\":\"Joint PhD supervision with international partners.\"},\"grants\":{\"title\":\"Mobility grants\",\"desc\":\"Funding for exchanges \u0026 research stays.\"},\"placements\":{\"title\":\"Placements \u0026 exchanges\",\"desc\":\"Internships, visits, and staff exchanges.\"}}},\"Event\":{\"title\":\"“Progress and Innovation in Ophthalmology” Forum 2025\",\"desc1\":\"The 3rd edition of “Eye and AI” workshop is jointly organized by the Department of Ophthalmology, “Iuliu Hațieganu” University of Medicine and Pharmacy, the Cluj County Emergency Clinical Hospital, and the Artificial Intelligence Research Institute (AIRi@UTCN), Technical University of Cluj-Napoca, Romania. Bringing together clinicians, researchers, and industry practitioners, the event explores how artificial intelligence is transforming ophthalmic care—from imaging and screening to decision support and workflow optimization.\",\"moderators\":\"Moderators:\",\"moderatorsNames\":\"Adrian GROZA, Anca MĂRGINEAN, Radu-Răzvan SLĂVESCU\",\"paper1Title\":\"Reconstructing Compact 3D OCT Volumes from B-scans: a Comparative Study of U-Net Architectures\",\"paper1Authors\":\"Adrian POP — Technical University, Cluj-Napoca\",\"paper2Title\":\"3D Reconstruction Based on the AROI Set\",\"paper2Authors\":\"Cristian Raul MOLDOVAN, Radu-Răzvan SLĂVESCU — Technical University, Cluj-Napoca\",\"paper3Title\":\"Adapting Vision Foundation Models for OCT and Eye Fundus\",\"paper3Authors\":\"Anca MĂRGINEAN — Technical University, Cluj-Napoca\",\"paper4Title\":\"Segmentation of the Retinal Vascular Network and Biomarker Quantification in OCTA Imaging\",\"paper4Authors\":\"Darius STAN, Raluca BREHAR — Technical University, Cluj-Napoca\",\"linkText\":\"View full event details →\"}},\"high-school\":{\"title\":\"High-school engagement\",\"description\":\"Competitions, events, and AI literacy resources for students and teachers.\",\"features\":{\"competitions\":{\"title\":\"Competitions\",\"desc\":\"AI and programming competitions for high-school students.\"},\"events\":{\"title\":\"Events\",\"desc\":\"Workshops, lab visits, and sessions with experts.\"},\"resources\":{\"title\":\"Educational resources\",\"desc\":\"Guides and materials for AI literacy.\"}},\"linkText\":\"AILIT Framework – Resources\"},\"industrial-phd\":{\"title\":\"Industrial PhD\",\"p1\":\"An Industrial PhD is known as a university training program that qualifies for the award of a doctorate through an industrial research or experimental development project, that was created collaboratively between a company and an academic environment, which will become the subject of a doctoral thesis by a doctoral student.\",\"p2\":\"If you are a company and are interested in carrying out an industrial PhD, contact us via email.\",\"p3\":\"If you want to come and do an Industrial Doctorate in Artificial Intelligence with us in any of the proposed topics, get in touch via email.\"},\"industry\":{\"title\":\"Industry engagement\",\"description\":\"Partner with AIRi on applied research and technology transfer, from discovery to deployment.\",\"Tabs\":{\"Overview\":\"Overview\",\"Projects\":\"Projects\",\"Engagement\":\"How we work\"},\"ProjectsTab\":{\"searchPlaceholder\":\"Search by project, lead, partner…\",\"allDomains\":\"All domains\",\"noProjects\":\"No projects match your filters yet.\",\"cardLead\":\"Lead\",\"cardDetails\":\"Details\",\"cardSite\":\"Site\",\"cardDocs\":\"Docs\"},\"EngagementTab\":{\"title\":\"Engagement model\",\"listItem1\":\"Joint applied research with measurable outcomes\",\"listItem2\":\"Prototyping and validation with your teams\",\"listItem3\":\"Knowledge transfer and long-term collaboration\"},\"OverviewTab\":{\"feature1Title\":\"Applied research\",\"feature1Desc\":\"Industrial collaborations targeting real-world deployment.\",\"feature2Title\":\"Co-development\",\"feature2Desc\":\"Shared roadmaps, rapid prototyping, and validation cycles.\",\"feature3Title\":\"Knowledge transfer\",\"feature3Desc\":\"Bridging research outcomes into production teams.\",\"statsProjects\":\"Active projects\",\"statsDomains\":\"Domains involved\",\"statsPartners\":\"Partners\"},\"Buttons\":{\"contact\":\"Contact the industry team\",\"explore\":\"Explore all projects\"}},\"partners\":{\"title\":\"Partners\",\"mapTitle\":\"Partners map\"},\"main\":{\"Hero\":{\"title\":\"Engagement\",\"subtitle\":\"Connecting AIRi @ UTCN with the public, academia, and industry.\"},\"Tabs\":{\"public\":\"Public\",\"academic\":\"Academic\",\"industry\":\"Industry\",\"high-school\":\"High-School\",\"partners\":\"Partners\",\"phd\":\"Industrial PhD\"},\"SubTabs\":{\"academic\":{\"partnerships\":\"Partnerships\",\"teaching\":\"Teaching\",\"courses\":\"Courses\",\"mobility\":\"Mobility\"},\"industry\":{\"overview\":\"Overview\",\"projects\":\"Projects\",\"engagement\":\"How We Work\"}},\"Public\":{\"title\":\"Public Engagement\",\"desc\":\"Connecting the AI research community with the broader public through accessible resources, media appearances, and outreach programs.\",\"btnMedia\":\"View Media \u0026 Press\",\"btnNews\":\"News \u0026 Events\",\"f1Title\":\"Outreach Programs\",\"f1Desc\":\"Public talks, demonstrations, and community engagement initiatives.\",\"f2Title\":\"Educational Resources\",\"f2Desc\":\"Open access materials explaining AI concepts to general audiences.\",\"f3Title\":\"Media Appearances\",\"f3Desc\":\"Interviews, articles, and media coverage of our research.\"},\"Academic\":{\"Partnerships\":{\"title\":\"Academic Partnerships\",\"desc\":\"A network of international academic collaborations, joint research programs, and institutional partnerships advancing AI research and education.\",\"f1Title\":\"University Collaborations\",\"f1Desc\":\"Joint research programs with leading universities worldwide.\",\"f2Title\":\"Research Networks\",\"f2Desc\":\"Participation in CLAIRE, ELLIS, and other European AI networks.\"},\"Teaching\":{\"title\":\"Teaching \u0026 Training\",\"desc\":\"Courses, summer schools, and workshops for students and researchers at all levels.\",\"f1Title\":\"Summer Schools\",\"f1Desc\":\"International summer programs in AI and machine learning.\",\"f2Title\":\"Workshops\",\"f2Desc\":\"Hands-on workshops and training sessions.\"},\"Courses\":{\"title\":\"Courses \u0026 Workshops\",\"desc\":\"Specialized courses covering machine learning, robotics, HPC for AI, and AI ethics.\",\"f1Title\":\"Machine Learning\",\"f1Desc\":\"Applied ML modules, projects, and research-oriented courses.\",\"f2Title\":\"Robotics \u0026 Vision\",\"f2Desc\":\"Hands-on labs in automation and vision systems.\",\"f3Title\":\"HPC for AI\",\"f3Desc\":\"GPU programming and large-scale AI training.\",\"f4Title\":\"AI Ethics \u0026 Safety\",\"f4Desc\":\"Fairness, explainability, and governance in AI systems.\"},\"Mobility\":{\"title\":\"Co-tutoring \u0026 Mobility\",\"desc\":\"International exchange programs, joint PhD supervision, and research visit opportunities.\",\"f1Title\":\"Co-supervision\",\"f1Desc\":\"Joint PhD supervision with international partners.\",\"f2Title\":\"Mobility Grants\",\"f2Desc\":\"Funding for research stays and exchanges.\",\"f3Title\":\"Exchanges\",\"f3Desc\":\"Student and researcher exchange programs.\"}},\"Industry\":{\"Stats\":{\"projects\":\"Projects\",\"domains\":\"Domains\",\"partners\":\"Partners\"},\"Collaboration\":{\"title\":\"Industry Collaboration\",\"desc\":\"We partner with industry leaders to advance AI research and bring innovations to market. Our collaborations span consulting, joint R\u0026D projects, and technology transfer.\"},\"Projects\":{\"searchPlaceholder\":\"Search projects...\",\"allDomains\":\"All Domains\",\"clear\":\"Clear\",\"lead\":\"Lead:\",\"noProjects\":\"No projects match your filters.\"},\"HowWeWork\":{\"title\":\"How We Work With Industry\",\"desc\":\"We offer various engagement models to suit different industry needs and collaboration depths.\",\"f1Title\":\"Joint R\u0026D Projects\",\"f1Desc\":\"Collaborative research projects with shared IP and outcomes.\",\"f2Title\":\"Consulting Services\",\"f2Desc\":\"Expert advice on AI strategy, implementation, and best practices.\",\"f3Title\":\"Training Programs\",\"f3Desc\":\"Customized training for industry teams on AI technologies.\",\"f4Title\":\"Technology Transfer\",\"f4Desc\":\"Licensing and commercialization of research outputs.\"}},\"HighSchool\":{\"title\":\"High-School Engagement\",\"desc\":\"Competitions, events, and AI literacy resources for students and teachers, fostering the next generation of AI researchers.\",\"f1Title\":\"Competitions\",\"f1Desc\":\"AI and programming competitions for high-school students.\",\"f2Title\":\"Events\",\"f2Desc\":\"Workshops, lab visits, and sessions with experts.\",\"f3Title\":\"Educational Resources\",\"f3Desc\":\"Guides and materials for AI literacy.\",\"btnFramework\":\"AILIT Framework – Resources\"},\"Partners\":{\"title\":\"Our Partners\",\"desc\":\"We collaborate with leading organizations in AI research and development, including CLAIRE, ELLIS, AIoD, euRobotics, ADRA, AI4Europe, and BDVA.\",\"mapTitle\":\"Partners Map\"},\"PhD\":{\"title\":\"Industrial PhD Program\",\"p1\":\"An Industrial PhD is a university training program that qualifies for the award of a doctorate through an industrial research or experimental development project, created collaboratively between a company and an academic environment.\",\"p2\":\"If you are a company interested in carrying out an industrial PhD, or if you want to pursue an Industrial Doctorate in Artificial Intelligence with us, please get in touch via email.\",\"f1Title\":\"For Companies\",\"f1Desc\":\"Partner with us for applied AI research that solves real business challenges.\",\"f2Title\":\"For Candidates\",\"f2Desc\":\"Combine academic research with practical industry experience.\",\"f3Title\":\"Collaboration Model\",\"f3Desc\":\"Joint supervision between industry mentors and academic advisors.\",\"btnContact\":\"Contact Us\"}},\"basic\":{\"Hero\":{\"title\":\"Engagement\",\"subtitle\":\"Connecting AIRi with the public, academia, and industry\"},\"Tabs\":{\"public\":\"Public\",\"academic\":\"Academic\",\"industry\":\"Industry\",\"highSchool\":\"High-School\",\"partners\":\"Partners\",\"phd\":\"Industrial PhD\"},\"SubTabs\":{\"partnerships\":\"Partnerships\",\"teaching\":\"Teaching\",\"courses\":\"Courses\",\"mobility\":\"Mobility\",\"overview\":\"Overview\",\"projects\":\"Projects\",\"engagement\":\"How We Work\"},\"PublicContent\":{\"title\":\"Public Engagement\",\"desc\":\"We actively engage with the public to demystify AI and share our findings.\",\"btnMedia\":\"Media Appearances\",\"btnNews\":\"News \u0026 Events\",\"outreachTitle\":\"Community Outreach\",\"outreachDesc\":\"Organizing open days, public lectures, and interactive demonstrations to bring AI closer to the community.\",\"eduTitle\":\"Educational Content\",\"eduDesc\":\"Creating accessible materials, blogs, and videos explaining complex AI concepts to a general audience.\",\"mediaTitle\":\"Media \u0026 Press\",\"mediaDesc\":\"Regular contributions to media outlets, expert commentary on AI trends, and press releases about our major discoveries.\"},\"AcademicContent\":{\"partnerTitle\":\"Academic Partnerships\",\"partnerDesc\":\"Building strong relationships with universities and research centers worldwide.\",\"uniTitle\":\"University Collaborations\",\"uniDesc\":\"Joint research projects and shared resources with leading academic institutions.\",\"netTitle\":\"Research Networks\",\"netDesc\":\"Active participation in international AI research consortia.\",\"teachTitle\":\"Teaching \u0026 Seminars\",\"teachDesc\":\"Contributing to the academic community through dedicated teaching activities.\",\"summerTitle\":\"Summer Schools\",\"summerDesc\":\"Intensive programs for students and early-career researchers.\",\"workTitle\":\"Workshops \u0026 Seminars\",\"workDesc\":\"Regular academic seminars presenting cutting-edge AI research.\",\"courseTitle\":\"University Courses\",\"courseDesc\":\"We design and deliver specialized AI courses at various academic levels.\",\"mlTitle\":\"Machine Learning\",\"mlDesc\":\"Fundamental and advanced courses in ML algorithms and applications.\",\"robotTitle\":\"Robotics \u0026 Vision\",\"robotDesc\":\"Specialized modules focusing on computer vision and intelligent robotics.\",\"hpcTitle\":\"High Performance Computing\",\"hpcDesc\":\"Training in utilizing supercomputing clusters for AI.\",\"ethicsTitle\":\"AI Ethics\",\"ethicsDesc\":\"Dedicated courses on responsible AI development and deployment.\",\"mobTitle\":\"Mobility \u0026 Exchange\",\"mobDesc\":\"Fostering international academic exchange and researcher mobility.\",\"supTitle\":\"PhD Supervision\",\"supDesc\":\"Co-supervision of doctoral candidates across international institutions.\",\"grantTitle\":\"Mobility Grants\",\"grantDesc\":\"Support for short and long-term research visits.\",\"exTitle\":\"Exchange Programs\",\"exDesc\":\"Facilitating researcher and student exchanges with partner universities.\"},\"IndustryContent\":{\"statProjects\":\"Industry Projects\",\"statDomains\":\"Research Domains\",\"statPartners\":\"Industry Partners\",\"collabTitle\":\"Industry Collaboration\",\"collabDesc\":\"AIRi partners with leading companies to translate cutting-edge AI research into real-world applications.\",\"searchPlaceholder\":\"Search industry projects...\",\"allDomains\":\"All domains\",\"clear\":\"Clear filters\",\"noProjects\":\"No industry projects found.\",\"leadLabel\":\"Lead:\",\"workTitle\":\"How We Work With Industry\",\"workDesc\":\"We offer flexible engagement models tailored to industry needs.\",\"rdTitle\":\"Joint R\u0026D\",\"rdDesc\":\"Collaborative research projects solving complex industrial challenges.\",\"consTitle\":\"Consulting\",\"consDesc\":\"Expert advisory services on AI strategy and implementation.\",\"trainTitle\":\"Corporate Training\",\"trainDesc\":\"Customized AI training programs for industry professionals.\",\"techTitle\":\"Technology Transfer\",\"techDesc\":\"Licensing and spin-off creation from our research outputs.\"},\"HighSchoolContent\":{\"title\":\"High-School Engagement\",\"desc\":\"Inspiring the next generation of AI researchers and engineers.\",\"compTitle\":\"Competitions\",\"compDesc\":\"Organizing AI and programming challenges for high-school students.\",\"eventTitle\":\"Open Events\",\"eventDesc\":\"Hosting lab tours and interactive workshops for schools.\",\"eduTitle\":\"Educational Resources\",\"eduDesc\":\"Providing materials for teachers to introduce AI in classrooms.\",\"btnLabel\":\"View AI Literacy Framework\"},\"PartnersContent\":{\"title\":\"Our Partners\",\"desc\":\"We are proud to collaborate with leading organizations across academia and industry.\",\"mapTitle\":\"Partner Map\",\"eyebrow\":\"Strategic Network\",\"stats\":{\"partners\":\"Partners\",\"countries\":\"Countries\",\"projects\":\"Projects\"},\"filters\":{\"searchPlaceholder\":\"Search by partner, country, project\",\"allCountries\":\"All countries\",\"allStatuses\":\"All statuses\",\"currentPartners\":\"Current partners\",\"formerPartners\":\"Former partners\",\"clear\":\"Clear\"},\"activeProjects\":\"Active Projects\",\"status\":{\"current\":\"Current\",\"former\":\"Former\"},\"actions\":{\"exploreProfile\":\"Explore Profile\",\"visitWebsite\":\"Visit website\"},\"empty\":{\"filtered\":\"No partners match your filters.\"}},\"PartnerDetails\":{\"back\":\"Partners\",\"visitOfficialWebsite\":\"Visit Official Website\",\"collaborativeProjects\":\"Collaborative Projects\",\"collaborativeProjectsSubtitle\":\"Research and initiatives featuring {partnerName}.\",\"noLinkedProjects\":\"No linked projects available yet.\"},\"PhDContent\":{\"title\":\"Industrial PhD Program\",\"p1\":\"Bridging the gap between academic research and industrial application.\",\"p2\":\"Our Industrial PhD program allows candidates to conduct rigorous academic research while solving real-world challenges within a partner company.\",\"compTitle\":\"For Companies\",\"compDesc\":\"Drive innovation by sponsoring a dedicated researcher to tackle your specific challenges.\",\"candTitle\":\"For Candidates\",\"candDesc\":\"Earn your PhD while gaining invaluable industry experience and a competitive salary.\",\"collabTitle\":\"Joint Supervision\",\"collabDesc\":\"Benefit from the combined expertise of academic supervisors and industry mentors.\",\"btnContact\":\"Contact Us About Industrial PhDs\"}}},\"about\":{\"mission\":{\"title\":\"Mission\",\"text\":\"The Artificial Intelligence Research Institute (AIRi) is a nexus for collaborative research at the Technical University of Cluj-Napoca. AIRi@UTCN promotes excellence in AI theory and practice, bringing together researchers across UTCN around a vision of open collaboration. Our work spans interdisciplinary research, AI literacy across disciplines, and impact through business and public co-creation partnerships.\"},\"history\":{\"title\":\"AIRI Timeline\",\"event1\":{\"date\":\"2023-01-15\",\"title\":\"Announcement of AI Institute at UTCN\",\"descrip